# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dbname

# ── LLM providers ────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_JUDGE_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL2=gemini-3.1-flash-lite

# ── Application ──────────────────────────────────────────
# APP_ENV: dev | test | prod
APP_ENV=dev

# AGENT_MODE: mock (in-memory data) | prod (real PostgreSQL)
AGENT_MODE=mock

# ── JWT secrets (per-tenant, HS256) ──────────────────────
# Format: JWT_SECRET_<TENANT_UUID_UPPERCASED_DASHES_TO_UNDERSCORES>
# Minimum 32 characters each. Example for a tenant with UUID
# a1b2c3d4-e5f6-7890-abcd-ef1234567890:
#
# JWT_SECRET_A1B2C3D4_E5F6_7890_ABCD_EF1234567890=your-32-char-minimum-secret-here!!
